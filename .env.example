# Contact / audit forms → email via Google Workspace (src/pages/api/contact.ts)
# GMAIL_USER must be a real Workspace mailbox; GMAIL_APP_PASSWORD is an app password for it
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=you@yourdomain.com
GMAIL_APP_PASSWORD=
# Optional: send notifications somewhere other than GMAIL_USER
FORM_NOTIFY_TO=
# Cloudflare Turnstile spam protection. Set both or neither. The site key is read at build time.
# Local testing: Cloudflare's always-pass test keys are
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
