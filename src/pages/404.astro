---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Khaotic Digital" description="That page doesn’t exist." noindex>
  <section class="section on-ink pattern-status"><div class="container">
    <span class="eyebrow"><span class="dot"></span>404</span>
    <h1>That page isn’t here.</h1>
    <p class="lede">It may have moved when the site was rebuilt. Try one of these:</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/insights/">Insights</a>
      <a class="btn btn-secondary" href="/services/">Services</a>
    </div>
  </div></section>
</BaseLayout>
