---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AuditCTA from '../../components/AuditCTA.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import { pillarLabel } from '../../data/site';
import { itemList } from '../../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Work', path: '/work/' }];
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const list = itemList('/work/', work.map((w) => ({ name: w.data.title, ...(w.data.draft ? {} : { path: `/work/${w.id}/` }) })));
---
<BaseLayout title="Work — Case Studies | Khaotic Digital" description="Selected projects: an AI startup’s application portal, sales and operations systems, CRM integrations, custom themes and platform migrations." crumbs={crumbs} pageTypes={['CollectionPage']} mainEntity={{ '@id': list['@id'] }} schema={[list]}>
  <PageHero crumbs={crumbs} eyebrow="Work" title="Client work" lede="A selection of client work from over 20 years. Clients are described by type unless they’ve agreed to be named." />
  <ProofStrip badges={false} />
  <section class="section">
    <div class="container grid grid-2">
      {work.map((w) => (
        <article class:list={['card', { 'card-link': !w.data.draft }]}>
          <span class="meta">{pillarLabel[w.data.pillar]} · {cap(w.data.client)}</span>
          <h2 style="font-size:var(--kd-step-2);margin:0">
            {w.data.draft ? w.data.title : <a class="stretched" href={`/work/${w.id}/`} style="color:inherit;text-decoration:none">{w.data.title}</a>}
          </h2>
          <p>{w.data.summary}</p>
          {w.data.quote && <p style="color:var(--kd-text);font-family:var(--kd-font-display);font-weight:500">“{cap(w.data.quote)}”</p>}
          {w.data.stack.length > 0 && <p class="meta push">{w.data.stack.join(' · ')}</p>}
        </article>
      ))}
    </div>
  </section>
  <AuditCTA />
</BaseLayout>
