---
import Icon from './Icon.astro';
import { pillars } from '../data/site';
interface Props { exclude?: string }
const { exclude } = Astro.props;
const list = Object.entries(pillars).filter(([k]) => k !== exclude);
---
<div class="grid grid-3">
  {list.map(([, p]) => (
    <article class="card card-link">
      <Icon name={p.icon} />
      <h3><a class="stretched" href={p.href} style="color:inherit;text-decoration:none">{p.name}</a></h3>
      <p class="tagline">{p.tagline}</p>
      <p>{p.problem}</p>
      <span class="push link-arrow" aria-hidden="true">How it works</span>
    </article>
  ))}
</div>
