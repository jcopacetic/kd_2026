---
// Brand service icons (brand/icons/svg/inline). 24px grid; size via CSS.
interface Props { name: string; class?: string; label?: string }
const { name, class: className = 'icon', label } = Astro.props;
const icons = import.meta.glob<string>('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = icons[`../assets/icons/${name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---
<span class={className} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={svg} />
<style>
  span { display: inline-block; line-height: 0; }
  span :global(svg) { width: 100%; height: 100%; }
</style>
